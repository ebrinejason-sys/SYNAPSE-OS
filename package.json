{
  "name": "synapse-os",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/web",
    "apps/pharmacy",
    "apps/app",
    "apps/lab-edge",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "verify": "npm run db:check && npm run test:opd-dispense-golden && npm run test:encounter-close-gate && npm run verify:web && npm run verify:pharmacy && npm run test:control-plane && npm run test:tenancy && npm run test:lab-edge && npm run test:clinical-writeup",
    "verify:web": "node scripts/verify-web-build.mjs",
    "verify:pharmacy": "npm run type-check --workspace @synapse/pharmacy && npm run lint --workspace @synapse/pharmacy && npm run test:general --workspace @synapse/pharmacy && npm run build --workspace @synapse/pharmacy",
    "verify:control-plane": "npm run test:control-plane",
    "verify:lab-edge": "npm run test:lab-edge",
    "test:workflow-safety": "node --test scripts/check-workflow-safety.test.mjs",
    "test:invitations:postgres": "bash scripts/db-tests/run-isolated.sh",
    "verify:pharm-release": "node scripts/verify-pharm-release.mjs",
    "verify:pharm-live": "node scripts/verify-pharm-live.mjs",
    "verify:pharm-release:live": "node scripts/verify-pharm-release.mjs --live",
    "verify:deploy": "npm run db:check && npm run verify:web",
    "db:check": "node scripts/check-supabase-migrations.mjs",
    "db:history:check": "node scripts/check-migration-history.mjs",
    "db:reconciliation:check": "node scripts/check-reconciliation-evidence.mjs",
    "opd:dispense:live": "node scripts/opd-dispense-live-journey.mjs --project-ref qfqakzmjatszisuqjwon",
    "test:opd-dispense-golden": "tsx --test packages/db/src/prescription-bridge.test.ts packages/db/src/opd-dispense-golden.test.ts",
    "test:migration-integrity": "node --test scripts/check-migration-history.test.mjs",
    "test:reconciliation-evidence": "node --test scripts/check-reconciliation-evidence.test.mjs",
    "test:tenancy": "vitest run apps/web/src/lib/tenant-routing.test.ts apps/web/src/lib/control-plane-security.test.ts",
    "test:lab-edge": "npm test --workspace @synapse/lab-edge",
    "simulate:astm": "npm start --workspace @synapse/lab-edge -- simulate:astm",
    "simulate:hl7": "npm start --workspace @synapse/lab-edge -- simulate:hl7",
    "db:lint": "supabase db lint --local",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:link": "supabase link --project-ref qfqakzmjatszisuqjwon",
    "db:migration:new": "supabase migration new",
    "db:migration:list": "supabase migration list",
    "vercel:pull": "vercel pull --yes",
    "vercel:build": "vercel build",
    "vercel:deploy": "vercel deploy --prebuilt",
    "vercel:status": "vercel ls",
    "vercel:inspect": "vercel inspect",
    "vercel:logs": "vercel logs",
    "deploy:status": "node scripts/check-deploy-status.mjs",
    "vercel:sync": "node scripts/sync-vercel-projects.mjs",
    "seed:admin-password": "tsx scripts/seed-admin-password.ts",
    "seed:pharmacy-pilot": "node scripts/pharmacy-pilot-seed.mjs",
    "seed:pharmacy-pilot:reset": "node scripts/pharmacy-pilot-seed.mjs --reset-inventory",
    "postinstall": "node scripts/patch-expo-metro-file-store.mjs || true; node scripts/nest-eslint-ajv6.mjs || true",
    "test:control-plane": "vitest run apps/web/src/lib/tenant-routing.test.ts packages/db/src/facility-provision.integration.test.ts apps/web/src/lib/control-plane-security.test.ts apps/web/src/lib/platform/require-admin-api.test.ts apps/web/src/app/api/platform/facilities/[id]/staff/route.test.ts apps/web/src/app/api/platform/simulation/route.test.ts apps/web/src/lib/platform/facility-invitations.server.test.ts apps/web/src/lib/platform/facility-invitations.integration.test.ts apps/web/src/app/api/platform/mfa/step-up/route.test.ts apps/web/src/app/api/opd/prescriptions/route.test.ts apps/web/src/app/api/hospital/pharmacy/dispense/route.test.ts apps/web/src/app/api/opd/encounters/[encounterId]/close/route.test.ts",
    "health:smoke": "node scripts/health-smoke.mjs",
    "readiness:report": "node scripts/readiness-report.mjs",
    "test:readiness-report": "node --test scripts/readiness-report.test.mjs",
    "test:encounter-close-gate": "tsx --test packages/db/src/encounter-close-gate.test.ts",
    "test:clinical-writeup": "tsx --test packages/db/src/clinical-writeup.test.ts"
  },
  "devDependencies": {
    "supabase": "^2.107.0",
    "turbo": "^2.0.0",
    "typescript": "~5.8.2",
    "vercel": "^54.14.2",
    "ajv6": "npm:ajv@6.12.6"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "ajv": "6.12.6"
    },
    "eslint": {
      "ajv": "6.12.6"
    },
    "expo": "~52.0.46",
    "react-native": "0.76.9",
    "metro": "0.81.5",
    "metro-cache": "0.81.5",
    "metro-config": "0.81.5",
    "metro-transform-worker": "0.81.5",
    "@synapse/app": {
      "ajv": "^8.17.1",
      "@types/react": "18.3.12",
      "scheduler": "0.24.0-canary-efb381bbf-20230505"
    }
  }
}
