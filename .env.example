# SynapseOS — root env template
# Copy to `.env` for scripts / local shared secrets.
# App runtimes also read `apps/web/.env.local` and `apps/pharmacy/.env.local`.

NODE_ENV=development

# Supabase (project qfqakzmjatszisuqjwon in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://your-project.supabase.co

# Custom Synapse auth (not Supabase Auth)
SYNAPSE_JWT_SECRET=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_PHARMACY_APP_URL=http://localhost:3002

# AI
GEMINI_API_KEY=

# Email
RESEND_API_KEY=

# Flutterwave (subscription billing)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=
CRON_SECRET=

# Optional integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
