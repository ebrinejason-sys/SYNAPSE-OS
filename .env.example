# SynapseOS — root env template
# Copy to `.env` for scripts / local shared secrets.
# App runtimes also read `apps/web/.env.local` and `apps/pharmacy/.env.local`.

NODE_ENV=development

# Supabase (project qfqakzmjatszisuqjwon in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://your-project.supabase.co

# Custom Synapse auth (not Supabase Auth)
SYNAPSE_JWT_SECRET=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_PHARMACY_APP_URL=http://localhost:3002

# AI — public clinical demo uses OpenRouter free models first
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Optional pin, e.g. openrouter/free or google/gemma-4-31b-it:free
OPENROUTER_MODEL=
GEMINI_API_KEY=

# Email
RESEND_API_KEY=

# Flutterwave (subscription billing)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=
CRON_SECRET=

# Optional integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# DHIS2 aggregate export (Phase 0–1). Default simulation outside production.
# Never set live without operator approval and MoH mapping review.
DHIS2_MODE=simulation
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
# Or token auth instead of basic:
DHIS2_TOKEN=
