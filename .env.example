# ── SynapseOS Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# App
APP_URL="http://localhost:5173"
NODE_ENV="development"

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ── Demo Mode ─────────────────────────────────────────────────────────────────
DEMO_EMAIL="demo@synapseos.tech"
DEMO_PASSWORD="Demo4321"
VITE_ENABLE_DEMO="true"
VITE_DEMO_MODE="sandbox"

# ── AI Providers ──────────────────────────────────────────────────────────────
# Google Gemini
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# DeepSeek (clinical reasoning, diagnosis)
DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"

# OpenRouter (multi-model AI gateway)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
VITE_OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ── WHO ICD-11 ────────────────────────────────────────────────────────────────
WHO_ICD11_CLIENT_ID="YOUR_WHO_ICD11_CLIENT_ID"
WHO_ICD11_CLIENT_SECRET="YOUR_WHO_ICD11_CLIENT_SECRET"
VITE_WHO_ICD11_TOKEN_ENDPOINT="https://icdaccessmanagement.who.int/connect/token"
VITE_WHO_ICD11_API_BASE="https://id.who.int/icd/release/11/2024-01/mms"

# ── Twilio (SMS / Voice) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="YOUR_TWILIO_PHONE_NUMBER"

# ── LiveKit (Telemedicine) ────────────────────────────────────────────────────
VITE_LIVEKIT_URL="YOUR_LIVEKIT_URL"
VITE_LIVEKIT_API_KEY="YOUR_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="YOUR_LIVEKIT_API_SECRET"

# ── Resend (Transactional Email) ──────────────────────────────────────────────
RESEND_API_KEY="YOUR_RESEND_API_KEY"

# ── Firebase (optional analytics) ────────────────────────────────────────────
VITE_FIREBASE_CONFIG=""
