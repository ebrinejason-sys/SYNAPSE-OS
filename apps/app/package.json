{
  "name": "@synapse/app",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "type-check": "tsc --noEmit",
    "export:android": "expo export --platform android",
    "build:apk": "eas build --platform android --profile preview --non-interactive",
    "prepare:assets": "node scripts/prepare-brand-assets.mjs",
    "postinstall": "node scripts/patch-expo-metro-file-store.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.46",
    "expo-clipboard": "~7.0.0",
    "expo-device": "~7.0.3",
    "expo-local-authentication": "~14.0.1",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.2",
    "expo-constants": "~17.0.7",
    "expo-font": "~13.0.4",
    "expo-image": "~2.0.7",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.13",
    "expo-router": "~4.0.20",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "sharp": "^0.35.2",
    "typescript": "^5.3.3"
  }
}
