NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Clinical demo uses OpenRouter free models first (set this on Vercel)
OPENROUTER_API_KEY=your-openrouter-key
# Optional. Default: openrouter/free plus other :free fallbacks
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=your-gemini-api-key
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+256700000000
RESEND_API_KEY=your-resend-key
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_PHARMACY_APP_URL=http://localhost:3002

# Flutterwave subscription billing (MTN MoMo, Airtel Money, card)
# Webhook: {NEXT_PUBLIC_APP_URL}/api/billing/webhook/flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=
CRON_SECRET=

# Sync to Vercel after filling root .env:
#   node scripts/sync-flutterwave-vercel.mjs
